# Base de données PostgreSQL (ex: Neon en production, localhost en dev)
DB_HOST=localhost
DB_PORT=5432
DB_USERNAME=postgres
DB_PASSWORD=your_password
DB_NAME=ecommerce_blog

# JWT — change ce secret en production (utilise une longue chaîne aléatoire)
JWT_SECRET=change_this_secret_in_production
JWT_EXPIRES_IN=7d

# Port du serveur NestJS
PORT=3301
