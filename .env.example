# Base de données PostgreSQL (ex: Neon en production, localhost en dev)
DB_HOST=localhost
DB_PORT=5432
DB_USERNAME=postgres
DB_PASSWORD=your_password
DB_NAME=ecommerce_blog

# JWT — change ce secret en production (utilise une longue chaîne aléatoire)
JWT_SECRET=change_this_secret_in_production
JWT_EXPIRES_IN=7d

# Port du serveur NestJS
PORT=3301

# Cloudinary — stockage des images uploadées (le disque du serveur est éphémère)
# Valeurs disponibles sur le dashboard Cloudinary après création du compte
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret
